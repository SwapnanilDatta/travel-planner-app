# Example environment variables for Travel Planner App
# Copy this file to .env and fill in real values locally or in your deployment platform.

# Application environment
APP_ENV=development        # set to 'production' in prod
DEBUG=True                # set to False in production
SECRET_KEY=replace-with-a-very-long-random-secret

# Hosts & port
ALLOWED_HOSTS=localhost,127.0.0.1
PORT=8000

# Database (replace with managed DB in production)
DATABASE_URL=postgresql://user:password@db-host:5432/dbname

# External services and API keys
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
HF_API_TOKEN=hf_xxx-your-hf-token-xxx
OPENCAGE_API_KEY=your-opencage-key

# Microservices (internal URLs)
MICROSERVICE_URL=http://microservice.internal:8000
MICROSERVICE2_URL=http://microservice2.internal:8000

# Caching / background jobs
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO

# Optional / DB SSL
DATABASE_SSL_MODE=require

# Notes:
# - Never commit a real .env into source control. Use a secret manager (AWS Secrets Manager, Vault, GitHub Secrets)
# - For production, set APP_ENV=production and DEBUG=False before starting services.
